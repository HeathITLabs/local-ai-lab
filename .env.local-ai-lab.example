# Copy this file to .env.local-ai-lab next to docker-compose.yml before running Docker Compose.

# Langfuse API keys from Langfuse UI: Settings -> API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me

# Optional override. For in-compose traffic, default is http://langfuse:3000
# LANGFUSE_HOST=http://langfuse:3000
